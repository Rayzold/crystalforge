// Scarred Lands Professions — Firestore rules.
// This file is the WHOLE rule set: it repeats the live realm rule,
// so it can replace what is in Firebase → Firestore → Rules. Put your GM UID in
// both places marked YOUR_GM_UID_HERE (via isGM()). Players sign in anonymously and claim a character
// with the code the GM gives them.
//
// Trust model: players only ever create pending rolls and proposed projects.
// Every number that changes progress passes through the GM's approval.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGM() {
      return signedIn() && request.auth.uid == "YOUR_GM_UID_HERE";
    }

    // Crystal Forge realm: kept exactly as it is live (2026-11-11). Any signed-in
    // (anonymous) user can write it. FIREBASE_GM_RULES.txt shows the GM-only version;
    // switching to it is a separate decision, after checking which pages write the realm.
    match /realms/{realmId} {
      allow read, write: if signedIn();
    }

    match /crafting/{realm} {
      function memberPath() {
        return /databases/$(database)/documents/crafting/$(realm)/members/$(request.auth.uid);
      }
      function isMember() {
        return signedIn() && exists(memberPath());
      }
      function myCharId() {
        return get(memberPath()).data.charId;
      }
      function downtimeOpen() {
        return get(/databases/$(database)/documents/crafting/$(realm)).data.downtime.open == true;
      }

      // Realm doc: downtime state, region levels.
      allow read: if signedIn();
      allow write: if isGM();

      match /characters/{charId} {
        allow read: if signedIn();
        allow write: if isGM();
      }

      // A code is a doc id. Knowing the code lets you read that one doc; nobody lists them.
      match /claims/{code} {
        allow get: if signedIn();
        allow list: if isGM();
        allow write: if isGM();
      }

      // Anonymous user → character. Created by the player with a valid code.
      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isGM());
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["charId", "code"])
          && request.resource.data.code is string
          && get(/databases/$(database)/documents/crafting/$(realm)/claims/$(request.resource.data.code)).data.charId
             == request.resource.data.charId;
        allow update, delete: if isGM();
      }

      // Everyone sees every project (rolls are public, like at the table).
      match /projects/{projectId} {
        allow read: if signedIn();
        allow create: if isGM() || (
          isMember()
          && request.resource.data.charId == myCharId()
          && request.resource.data.status == "proposed"
          && request.resource.data.weeksDone == 0
          && request.resource.data.complications == 0
        );
        allow update, delete: if isGM();
      }

      // Gathering results happen during travel, not downtime: no downtimeOpen() check.
      match /gathering/{entryId} {
        allow read: if signedIn();
        allow create: if isGM() || (
          isMember()
          && request.resource.data.charId == myCharId()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == "pending"
        );
        allow update, delete: if isGM();
      }

      match /log/{entryId} {
        allow read: if signedIn();
        allow create: if isGM() || (
          isMember()
          && downtimeOpen()
          && request.resource.data.charId == myCharId()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == "pending"
        );
        allow update, delete: if isGM();
      }
    }
  }
}
